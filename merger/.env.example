# نسخ هذا الملف إلى merger/.env — القيم الحقيقية تُضبط في Vercel أيضًا
TURSO_DATABASE_URL=libsql://<your-db>-<your-user>.aws-eu-west-1.turso.io
TURSO_AUTH_TOKEN=<your-turso-token>

# الحدود (اختياري — الافتراضيات معقولة)
MAX_SOURCES=10
SOURCE_MAX_MB=200
OUTPUT_MAX_MB=150
MAX_TOTAL_DURATION_SEC=600
FFMPEG_PRESET=medium
PORT=8787
