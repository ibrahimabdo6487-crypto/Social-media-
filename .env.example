# نسخ هذا الملف إلى .env.local (تطبيق MCP) — القيم الحقيقية تُضبط في Vercel أيضًا

# قاعدة البيانات (Turso → libSQL)
TURSO_DATABASE_URL=libsql://<your-db>-<your-user>.aws-eu-west-1.turso.io
TURSO_AUTH_TOKEN=<your-turso-token>

# خدمة دمج الفيديو — انشر مجلد merger كـ Vercel Project مستقل ثم ضع رابطه هنا
MERGER_API_BASE=https://<your-merger-project>.vercel.app

# اختياري: توكيد حماية نقطة MCP (يُرسل العميل في ترويسة Authorization: Bearer)
# MCP_ACCESS_TOKEN=

# اختياري: تجاوز أسماء الموديلات لدى المزودين (الافتراضيات مثبتة من المواصفة)
# KIE_IMAGE_MODEL=gpt-image-2-6/flare-text-to-image
# KIE_VIDEO_MODEL=grok-imagine-video-1-5-preview
# COMETAPI_IMAGE_MODEL=gpt-image-2.6-flare-text-to-image
# COMETAPI_VIDEO_MODEL=grok-imagine-video-1-5-preview
